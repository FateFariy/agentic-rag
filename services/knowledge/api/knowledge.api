syntax = "v1"

info (
	title:   "知识管理服务接口"
	desc:    "知识范围、知识主题、文档画像、主题文档关联、知识路由追踪"
	author:  "susu"
	version: "v1.0.0"
)

// ==================== 请求类型定义 ====================
type (
	// 保存知识范围请求
	KnowledgeScopeSaveReq {
		ID              string `json:"id,optional"` // 主键ID
		KnowledgeBaseId string `json:"knowledgeBaseId"` // 知识库ID
		ScopeName       string `json:"scopeName"` // 范围名称
		ParentScopeId   string `json:"parentScopeId,optional"` // 上级范围ID
		Description     string `json:"description,optional"` // 描述
		Aliases         string `json:"aliases,optional"` // 别名
		Examples        string `json:"examples,optional"` // 示例
		SortOrder       int    `json:"sortOrder,optional"` // 排序
	}
	// 删除知识范围请求
	KnowledgeScopeDeleteReq {
		ID              string `json:"id"` // 主键ID
		KnowledgeBaseId string `json:"knowledgeBaseId"` // 知识库ID
	}
	// 查询知识范围列表请求
	KnowledgeScopeListReq {
		KnowledgeBaseId string `json:"knowledgeBaseId"` // 知识库ID
	}
	// 保存知识主题请求
	KnowledgeTopicSaveReq {
		ID                  string `json:"id,optional"` // 主键ID
		KnowledgeBaseId     string `json:"knowledgeBaseId"` // 知识库ID
		ScopeId             string `json:"scopeId"` // 范围ID
		TopicName           string `json:"topicName"` // 主题名称
		Description         string `json:"description,optional"` // 描述
		Aliases             string `json:"aliases,optional"` // 别名
		Examples            string `json:"examples,optional"` // 示例
		AnswerShape         string `json:"answerShape,optional"` // 答复形态
		ExecutionPreference string `json:"executionPreference,optional"` // 执行偏好
		SortOrder           int    `json:"sortOrder,optional"` // 排序
	}
	// 删除知识主题请求
	KnowledgeTopicDeleteReq {
		ID              string `json:"id"` // 主键ID
		KnowledgeBaseId string `json:"knowledgeBaseId"` // 知识库ID
	}
	// 查询知识主题列表请求
	KnowledgeTopicListReq {
		KnowledgeBaseId string `json:"knowledgeBaseId"` // 知识库ID
		ScopeId         string `json:"scopeId,optional"` // 范围ID
	}
	// 查询主题文档关联列表请求
	TopicDocumentRelationListReq {
		TopicId         string `json:"topicId"` // 主题ID
		KnowledgeBaseId string `json:"knowledgeBaseId"` // 知识库ID
	}
	// 保存主题文档关联请求
	TopicDocumentRelationSaveReq {
		TopicId         string  `json:"topicId"` // 主题ID
		KnowledgeBaseId string  `json:"knowledgeBaseId"` // 知识库ID
		DocumentId      string  `json:"documentId"` // 文档ID
		RelationScore   float64 `json:"relationScore,optional"` // 关联分数
		RelationSource  string  `json:"relationSource,optional"` // 关联来源
		Reason          string  `json:"reason,optional"` // 理由
	}
	// 移除主题文档关联请求
	TopicDocumentRelationRemoveReq {
		TopicId         string `json:"topicId"` // 主题ID
		KnowledgeBaseId string `json:"knowledgeBaseId"` // 知识库ID
		DocumentId      string `json:"documentId"` // 文档ID
	}
)

// ==================== 响应类型定义====================
type (
	// 知识范围响应
	KnowledgeScopeResp {
		ID              string `json:"id"` // 主键ID
		KnowledgeBaseId string `json:"knowledgeBaseId"` // 知识库ID
		ScopeName       string `json:"scopeName"` // 范围名称
		ParentScopeId   string `json:"parentScopeId"` // 上级范围ID
		Description     string `json:"description"` // 描述
		Aliases         string `json:"aliases"` // 别名
		Examples        string `json:"examples"` // 示例
		SortOrder       int    `json:"sortOrder"` // 排序
	}
	// 知识主题响应
	KnowledgeTopicResp {
		ID                  string `json:"id"` // 主键ID
		KnowledgeBaseId     string `json:"knowledgeBaseId"` // 知识库ID
		TopicName           string `json:"topicName"` // 主题名称
		ScopeId             string `json:"scopeId"` // 所属范围ID
		Description         string `json:"description"` // 描述
		Aliases             string `json:"aliases"` // 别名
		Examples            string `json:"examples"` // 示例
		AnswerShape         string `json:"answerShape"` // 答复形态
		ExecutionPreference string `json:"executionPreference"` // 执行偏好
		SortOrder           int    `json:"sortOrder"` // 排序
	}
	// 主题文档关联响应
	TopicDocumentRelationResp {
		KnowledgeBaseId string  `json:"knowledgeBaseId"` // 知识库ID
		TopicId         string  `json:"topicId"` // 主题ID
		TopicName       string  `json:"topicName"` // 主题名称
		ScopeId         string  `json:"scopeId"` // 所属范围ID
		ScopeName       string  `json:"scopeName"` // 所属范围名称
		DocumentId      string  `json:"documentId"` // 文档ID
		DocumentName    string  `json:"documentName"` // 文档名称
		RelationScore   float64 `json:"relationScore"` // 关联分数
		RelationSource  string  `json:"relationSource"` // 关联来源
		Reason          string  `json:"reason"` // 理由
	}

	// 知识库明细响应
	KnowledgeBaseItemResp {
		ID                       string `json:"id"` // 主键ID
		BaseName                 string `json:"baseName"` // 知识库名称
		Description              string `json:"description"` // 描述
		RetrievalConfigJson      string `json:"retrievalConfigJson"` // 检索配置JSON
		GraphRagConfigJson       string `json:"graphRagConfigJson"` // 图谱RAG配置JSON
		MetadataFilterJson       string `json:"metadataFilterJson"` // 元数据过滤JSON
		IsDefault                int    `json:"isDefault"` // 是否默认
		SortOrder                int    `json:"sortOrder"` // 排序
		DocumentCount            int    `json:"documentCount"` // 文档数量
		RetrievableDocumentCount int    `json:"retrievableDocumentCount"` // 可检索文档数量
	}
	// 知识库选项响应
	KnowledgeBaseOptionResp {
		ID                       string `json:"id"` // 主键ID
		BaseName                 string `json:"baseName"` // 知识库名称
		Description              string `json:"description"` // 描述
		IsDefault                int    `json:"isDefault"` // 是否默认
		RetrievableDocumentCount int    `json:"retrievableDocumentCount"` // 可检索文档数量
	}
)

// ==================== 知识管理服务====================
@server (
	group:  knowledge
	desc:   "知识管理服务"
	prefix: /manage/knowledge
)
service knowledge {
	@doc "保存知识范围节点"
	@handler SaveKnowledgeScope
	post /scope/save (KnowledgeScopeSaveReq) returns (KnowledgeScopeResp)

	@doc "删除知识范围节点"
	@handler DeleteKnowledgeScope
	post /scope/delete (KnowledgeScopeDeleteReq) returns (bool)

	@doc "查询知识范围列表"
	@handler ListKnowledgeScope
	post /scope/list (KnowledgeScopeListReq) returns ([]*KnowledgeScopeResp)

	@doc "保存知识主题节点"
	@handler SaveKnowledgeTopic
	post /topic/save (KnowledgeTopicSaveReq) returns (KnowledgeTopicResp)

	@doc "删除知识主题节点"
	@handler DeleteKnowledgeTopic
	post /topic/delete (KnowledgeTopicDeleteReq) returns (bool)

	@doc "查询知识主题列表"
	@handler ListKnowledgeTopic
	post /topic/list (KnowledgeTopicListReq) returns ([]*KnowledgeTopicResp)

	@doc "查询主题文档关联"
	@handler ListTopicDocumentRelation
	post /topic/document/list (TopicDocumentRelationListReq) returns ([]*TopicDocumentRelationResp)

	@doc "保存主题文档关联"
	@handler SaveTopicDocumentRelation
	post /topic/document/save (TopicDocumentRelationSaveReq) returns (TopicDocumentRelationResp)

	@doc "删除主题文档关联"
	@handler DeleteTopicDocumentRelation
	post /topic/document/remove (TopicDocumentRelationRemoveReq) returns (bool)

	@doc "查询知识库列表"
	@handler ListKnowledgeBase
	post /base/list returns ([]*KnowledgeBaseItemResp)
}
